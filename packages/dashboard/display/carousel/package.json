{
  "name": "@easy-editor/materials-dashboard-carousel",
  "version": "0.0.8",
  "description": "Carousel component for EasyEditor dashboard",
  "type": "module",
  "main": "dist/index.min.cjs",
  "module": "dist/index.min.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.min.esm.js",
      "require": "./dist/index.min.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Easy-Editor/EasyMaterials",
  "license": "MIT",
  "author": "JinSo <kimjinso@qq.com>",
  "keywords": [
    "@easy-editor",
    "easyeditor",
    "low-code",
    "dashboard",
    "carousel",
    "component",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Easy-Editor/EasyMaterials",
    "directory": "packages/dashboard/carousel"
  },
  "bugs": {
    "url": "https://github.com/Easy-Editor/EasyMaterials/issues"
  },
  "peerDependencies": {
    "@easy-editor/core": "*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19"
  },
  "scripts": {
    "dev": "easypack dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "build": "npm-run-all -nl build:*",
    "build:clean": "rimraf dist/",
    "build:js": "easypack build",
    "build:types": "tsc --project tsconfig.json && node ../../../../scripts/prepare-material-types.mjs"
  },
  "devDependencies": {
    "@easy-editor/materials-shared": "workspace:*"
  }
}
